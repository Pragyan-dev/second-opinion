{
  "$defs": {
    "AgentResult": {
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "title": "Data",
          "type": "object"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "agent",
        "status"
      ],
      "title": "AgentResult",
      "type": "object"
    },
    "Article": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "outlet": {
          "title": "Outlet",
          "type": "string"
        },
        "published": {
          "title": "Published",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "relevance": {
          "title": "Relevance",
          "type": "number"
        },
        "is_press_release": {
          "title": "Is Press Release",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "url",
        "outlet",
        "published",
        "summary",
        "relevance",
        "is_press_release"
      ],
      "title": "Article",
      "type": "object"
    },
    "Capture": {
      "properties": {
        "source_type": {
          "enum": [
            "website",
            "email",
            "social_post",
            "stock_page"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender"
        },
        "links": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "emails": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Emails",
          "type": "array"
        },
        "phones": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Phones",
          "type": "array"
        },
        "tickers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tickers",
          "type": "array"
        }
      },
      "required": [
        "source_type",
        "url",
        "title",
        "text"
      ],
      "title": "Capture",
      "type": "object"
    },
    "FraudReport": {
      "properties": {
        "report_id": {
          "title": "Report Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "website",
            "email",
            "social_post",
            "stock_page"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "page_url": {
          "title": "Page Url",
          "type": "string"
        },
        "entities": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Entities",
          "type": "object"
        },
        "site_visit": {
          "anyOf": [
            {
              "$ref": "#/$defs/SiteVisit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "jev_scores": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JevScore"
          },
          "title": "Jev Scores",
          "type": "array"
        },
        "fraud_likelihood": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraud Likelihood"
        },
        "band": {
          "anyOf": [
            {
              "enum": [
                "low",
                "elevated",
                "high",
                "cant_tell"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band"
        },
        "band_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Band Reason"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "official_contact": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfficialContact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stock_pros": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProCon"
          },
          "title": "Stock Pros",
          "type": "array"
        },
        "stock_cons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProCon"
          },
          "title": "Stock Cons",
          "type": "array"
        },
        "stock_research_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stock Research Id"
        }
      },
      "required": [
        "report_id",
        "status",
        "source_type",
        "page_url",
        "entities"
      ],
      "title": "FraudReport",
      "type": "object"
    },
    "FundingRequest": {
      "properties": {
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "from_account_id": {
          "title": "From Account Id",
          "type": "string"
        },
        "to_account_id": {
          "title": "To Account Id",
          "type": "string"
        },
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "human_confirmed": {
          "title": "Human Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "customer_id",
        "from_account_id",
        "to_account_id",
        "amount",
        "human_confirmed"
      ],
      "title": "FundingRequest",
      "type": "object"
    },
    "JevScore": {
      "properties": {
        "flag": {
          "title": "Flag",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "flag",
        "label",
        "confidence",
        "evidence"
      ],
      "title": "JevScore",
      "type": "object"
    },
    "OfficialContact": {
      "properties": {
        "firm": {
          "title": "Firm",
          "type": "string"
        },
        "crd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crd"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "firm",
        "source"
      ],
      "title": "OfficialContact",
      "type": "object"
    },
    "OrderPreview": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "last_price": {
          "title": "Last Price",
          "type": "number"
        },
        "est_total": {
          "title": "Est Total",
          "type": "number"
        },
        "tradable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tradable"
        },
        "buying_power_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buying Power Ok"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "data_source": {
          "enum": [
            "robinhood_mcp",
            "cached",
            "simulated"
          ],
          "title": "Data Source",
          "type": "string"
        },
        "status": {
          "const": "awaiting_human",
          "default": "awaiting_human",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "name",
        "last_price",
        "est_total",
        "data_source"
      ],
      "title": "OrderPreview",
      "type": "object"
    },
    "OrderTicket": {
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "side": {
          "const": "buy",
          "default": "buy",
          "title": "Side",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "order_type": {
          "enum": [
            "market",
            "limit"
          ],
          "title": "Order Type",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "time_in_force": {
          "default": "gfd",
          "enum": [
            "gfd",
            "gtc"
          ],
          "title": "Time In Force",
          "type": "string"
        },
        "research_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
