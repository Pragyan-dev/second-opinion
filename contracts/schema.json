      "required": [
        "symbol",
        "quantity",
        "order_type"
      ],
      "title": "OrderTicket",
      "type": "object"
    },
    "ProCon": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text"
      ],
      "title": "ProCon",
      "type": "object"
    },
    "Signal": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "check": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "unknown"
          ],
          "title": "Check",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
