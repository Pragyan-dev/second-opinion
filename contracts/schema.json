        "weight": {
          "default": 0,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "check",
        "detail"
      ],
      "title": "Signal",
      "type": "object"
    },
    "SiteVisit": {
      "properties": {
        "start_url": {
          "title": "Start Url",
          "type": "string"
        },
        "final_url": {
          "title": "Final Url",
          "type": "string"
        },
        "pages_visited": {
          "items": {
            "type": "string"
          },
          "title": "Pages Visited",
          "type": "array"
        },
        "claimed_firm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Firm"
        },
        "claimed_crd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Crd"
        },
        "phones": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Phones",
          "type": "array"
        },
        "emails": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Emails",
          "type": "array"
        },
        "domain_age_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Age Days"
        }
      },
      "required": [
        "start_url",
        "final_url",
        "pages_visited"
      ],
      "title": "SiteVisit",
      "type": "object"
    },
    "Source": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "Source",
      "type": "object"
    },
    "StockReport": {
      "properties": {
        "research_id": {
          "title": "Research Id",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "asset_type": {
          "enum": [
            "stock",
            "etf",
            "unknown"
          ],
          "title": "Asset Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "sections": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentResult"
          },
          "title": "Sections",
          "type": "object"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "articles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Article"
          },
          "title": "Articles",
          "type": "array"
        },
        "pros": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProCon"
          },
          "title": "Pros",
          "type": "array"
        },
        "cons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProCon"
          },
          "title": "Cons",
          "type": "array"
        },
        "questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "research_id",
        "symbol",
        "asset_type",
        "status",
        "sections"
      ],
      "title": "StockReport",
      "type": "object"
    }
