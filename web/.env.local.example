# Optional. By default the dashboard proxies /backend/* to BACKEND_URL (default http://127.0.0.1:8000).
# Point the proxy at the mock instead:
# BACKEND_URL=http://127.0.0.1:8001
# Or call an API directly from the browser (CORS then only allows http://localhost:3000):
# NEXT_PUBLIC_API_BASE=http://localhost:8001
# Seeded Nessie sandbox ids (origin/mansi). Offline mode ignores them.
NEXT_PUBLIC_NESSIE_CUSTOMER_ID=68395a5e-076e-49fe-ba22-a1c86daf2d2b
NEXT_PUBLIC_NESSIE_FROM_ACCOUNT_ID=a04e20c2-440e-4743-bb2c-9a436f303fa1
NEXT_PUBLIC_NESSIE_TO_ACCOUNT_ID=02cb4b23-cf32-47df-9b85-d68b4aba25e5
# Set to 1 to honour ?preview=cant_tell in a production build.
NEXT_PUBLIC_DEMO_TOOLS=
