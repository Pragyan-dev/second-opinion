{
  "manifest_version": 3,
  "name": "Second Opinion (demo)",
  "version": "0.2.0",
  "description": "Fixture-backed fraud checks, stock research, and human-reviewed funding.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:8001/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://robinhood.com/stocks/*",
        "https://x.com/*",
        "https://mail.google.com/*",
        "http://localhost:5500/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "detectors/*.js",
        "lib/capture.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
