# Pick a model whose OpenRouter page lists structured outputs support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_REFERER=
# Jev (TypeSafe) on OpenRouter's Decisions API. JEV_API_KEY defaults to OPENROUTER_API_KEY.
JEV_API_KEY=
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14
NESSIE_API_KEY=
NEWS_API_KEY=
SEC_USER_AGENT=
USE_FIXTURES=1
# Comma list of agents that stay on fixtures when USE_FIXTURES=0, e.g. crawl,jev
FIXTURE_AGENTS=
AGENT_TIMEOUT_S=8
CRAWL_ALLOW_HOSTS=localhost:5500,127.0.0.1:5500
# Demo only: fetch the fictional host from the local demo site
CRAWL_HOST_ALIASES=brightwater-capital.example=http://127.0.0.1:5500
LIVE_BROKERCHECK=0
BROKERCHECK_SEARCH_URL=https://api.brokercheck.finra.org/search/firm
BANK_OFFLINE=0
NEXT_PUBLIC_API_BASE=http://localhost:8000
ROBINHOOD_MCP_URL=
# brave or tavily
SEARCH_PROVIDER=
SEARCH_API_KEY=
