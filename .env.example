# Pick a model whose OpenRouter page lists structured outputs support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_REFERER=
# Provider routing: latency (default, about 0.5 s for DeepSeek), throughput, price, or empty
OPENROUTER_PROVIDER_SORT=latency
# Jev (TypeSafe) on OpenRouter's Decisions API. JEV_API_KEY defaults to OPENROUTER_API_KEY.
JEV_API_KEY=
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14
NESSIE_API_KEY=
NEWS_API_KEY=
SEC_USER_AGENT=
USE_FIXTURES=0
# Comma list of agents that stay on fixtures when USE_FIXTURES=0, e.g. crawl,jev
FIXTURE_AGENTS=
AGENT_TIMEOUT_S=8
CRAWL_ALLOW_HOSTS=localhost:5500,127.0.0.1:5500
# Demo only: fetch the fictional host from the local demo site
CRAWL_HOST_ALIASES=brightwater-capital.example=http://127.0.0.1:5500
LIVE_BROKERCHECK=1
# Watch-only live view of the agent's browser; needs: pip install -e './backend[browser]' && playwright install chromium
LIVE_VIEW_ENABLED=1
LIVE_VIEW_SECONDS_PER_PAGE=6
LIVE_VIEW_MAX_PAGES=5
BROKERCHECK_SEARCH_URL=https://api.brokercheck.finra.org/search/firm
BANK_OFFLINE=0
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Robinhood MCP — endpoint defaults to https://agent.robinhood.com/mcp/trading
# Token: extract from Cursor's OAuth session after signing in to Robinhood.
# Without a token the backend falls back to simulated quotes.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=
RH_ALLOWED_TOOLS=
# brave or tavily
SEARCH_PROVIDER=
SEARCH_API_KEY=
DATA_OFFLINE=0
CACHE_DIR=
NESSIE_CUSTOMER_ID=
NESSIE_CHECKING_ID=
NESSIE_BROKERAGE_ID=
